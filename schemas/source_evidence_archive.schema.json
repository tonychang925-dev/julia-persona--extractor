{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-persona.org/schemas/source_evidence_archive.schema.json",
  "title": "Source Evidence Archive",
  "description": "Lossless source-preserving evidence envelope for one evidence unit (M0 §8, §9, §10.5, §10.6).",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_archive_id",
    "source_manifest_ref",
    "source_unit",
    "source_native",
    "nodes",
    "accounting"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "evidence_archive_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sea_[0-9a-f]{64}$"
    },
    "source_manifest_ref": { "type": "string", "minLength": 1 },
    "source_unit": {
      "type": "object",
      "required": ["unit_type", "source_native_id", "source_pointer"],
      "properties": {
        "unit_type": { "type": "string", "minLength": 1 },
        "source_native_id": { "type": "string", "minLength": 1 },
        "source_pointer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "source_native": {
      "type": "object",
      "required": ["source_type", "conversation_id", "current_node", "title"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "conversation_id": { "type": "string", "minLength": 1 },
        "current_node": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/sea_node" }
    },
    "accounting": {
      "$ref": "#/$defs/accounting"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sea_node": {
      "type": "object",
      "required": [
        "source_node_id",
        "node_evidence_id",
        "source_payload",
        "provenance"
      ],
      "properties": {
        "source_node_id": { "type": "string", "minLength": 1 },
        "node_evidence_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^node_[0-9a-f]{64}$"
        },
        "source_payload": { "type": "object" },
        "structural_projection": {
          "type": "object",
          "properties": {
            "parent_node_id": { "type": ["string", "null"] },
            "message_id": { "type": ["string", "null"] },
            "role": { "type": ["string", "null"] },
            "create_time_raw": { "type": ["number", "null"] },
            "content_type": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_archive_ref",
            "source_sha256",
            "json_pointer",
            "source_node_id",
            "canonical_node_hash"
          ],
          "properties": {
            "source_archive_ref": { "type": "string", "minLength": 1 },
            "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "json_pointer": { "type": "string", "minLength": 1 },
            "source_node_id": { "type": "string", "minLength": 1 },
            "canonical_node_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "not": { "required": ["node_id"] }
    },
    "accounting": {
      "type": "object",
      "required": [
        "source_node_count",
        "preserved_node_count",
        "excluded_node_count",
        "exclusions"
      ],
      "properties": {
        "source_node_count": { "type": "integer", "minimum": 0 },
        "preserved_node_count": { "type": "integer", "minimum": 0 },
        "excluded_node_count": { "type": "integer", "minimum": 0 },
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exclusion_record" }
        }
      },
      "additionalProperties": false
    },
    "exclusion_record": {
      "type": "object",
      "required": [
        "source_object_ref",
        "json_pointer",
        "canonical_object_hash",
        "exclusion_reason_code",
        "exclusion_rule_id",
        "exclusion_rule_version",
        "adapter"
      ],
      "properties": {
        "source_object_ref": { "type": "string", "minLength": 1 },
        "json_pointer": { "type": "string", "minLength": 1 },
        "canonical_object_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "exclusion_reason_code": { "type": "string", "minLength": 1 },
        "exclusion_rule_id": { "type": "string", "minLength": 1 },
        "exclusion_rule_version": { "type": "string", "minLength": 1 },
        "adapter": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
