{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-persona.org/schemas/causal_experience.schema.json",
  "title": "Causal Experience Node",
  "type": "object",
  "required": ["schema_version", "experience_id", "evidence_refs", "observed_event", "interpretation", "confidence", "causal_density", "lifecycle"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2.0" },
    "experience_id": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" }, "minItems": 1 },
    "observed_event": {
      "type": "object",
      "required": ["trigger", "response", "messages"],
      "properties": {
        "trigger": { "type": "string" },
        "response": { "type": "string" },
        "messages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "temporal_scope": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "required": ["causal_claim", "transition", "relationship_delta", "behavioral_consequence", "activation_conditions"],
      "properties": {
        "causal_claim": { "type": "string" },
        "transition": { "type": "string" },
        "relationship_delta": { "type": "string" },
        "behavioral_consequence": { "type": "string" },
        "activation_conditions": { "type": "array", "items": { "type": "string" } },
        "claim_fields_supported": { "type": "array", "items": { "type": "string" } },
        "claim_fields_uncertain": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["overall", "evidence_quality", "causal_confidence", "counter_evidence_resistance"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "causal_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "counter_evidence_resistance": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "causal_density": {
      "type": "object",
      "required": ["score", "evidence_frequency", "temporal_persistence", "behavioral_consequence", "cross_context_activation", "counter_evidence_resistance"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_frequency": { "type": "number", "minimum": 0, "maximum": 1 },
        "temporal_persistence": { "type": "number", "minimum": 0, "maximum": 1 },
        "behavioral_consequence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cross_context_activation": { "type": "number", "minimum": 0, "maximum": 1 },
        "counter_evidence_resistance": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "lifecycle": { "$ref": "#/$defs/lifecycle" }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "required": ["archive_id", "message_ids"],
      "properties": {
        "archive_id": { "type": "string", "minLength": 1 },
        "segment_id": { "type": ["string", "null"] },
        "candidate_id": { "type": ["string", "null"] },
        "message_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["current_state", "history"],
      "properties": {
        "current_state": { "type": "string", "enum": ["created", "extracted", "review_pending", "validated", "installed", "active", "challenged", "deprecated"] },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "actor", "timestamp", "reason"],
            "properties": {
              "from": { "type": ["string", "null"] },
              "to": { "type": "string" },
              "actor": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" },
              "reason": { "type": "string" },
              "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
