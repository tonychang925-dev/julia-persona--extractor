{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-persona.org/schemas/normalized_archive.schema.json",
  "title": "Normalized Conversation Archive",
  "type": "object",
  "required": ["schema_version", "conversation_id", "participants", "messages", "provenance"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "conversation_id": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participant_id", "role"],
        "properties": {
          "participant_id": { "type": "string" },
          "role": { "type": "string" },
          "display_name": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message_id", "role", "content", "provenance"],
        "properties": {
          "message_id": { "type": "string" },
          "role": { "type": "string" },
          "participant_id": { "type": ["string", "null"] },
          "content": { "type": "string" },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "provenance": { "$ref": "#/$defs/provenance" }
        },
        "additionalProperties": false
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source_type"],
      "properties": {
        "source_type": { "type": "string" },
        "source_path": { "type": ["string", "null"] },
        "source_id": { "type": ["string", "null"] },
        "source_offset": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
