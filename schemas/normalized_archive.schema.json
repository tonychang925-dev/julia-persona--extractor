{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-persona.org/schemas/normalized_archive.schema.json",
  "title": "Normalized Conversation Archive",
  "description": "Cross-source normalized projection with mandatory traceability to exact source evidence (M0 §15). Not the raw evidence authority.",
  "type": "object",
  "required": [
    "schema_version",
    "archive_id",
    "source_evidence_archive_ref",
    "source_identity",
    "provenance",
    "immutability",
    "participants",
    "messages"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.3.0" },
    "archive_id": { "type": "string", "minLength": 1 },
    "source_evidence_archive_ref": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "source_identity": {
      "type": "object",
      "required": ["source_type", "source_id", "ingested_at"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": ["string", "null"] },
        "source_uri": { "type": ["string", "null"] },
        "ingested_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "provenance": { "$ref": "#/$defs/provenance_record" },
    "immutability": {
      "type": "object",
      "required": ["normalized_content_hash", "raw_content_hash", "normalization_adapter", "normalization_version"],
      "properties": {
        "normalized_content_hash": { "type": ["string", "null"] },
        "raw_content_hash": { "type": ["string", "null"] },
        "normalization_adapter": { "type": "string", "minLength": 1 },
        "normalization_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participant_id", "role"],
        "properties": {
          "participant_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "display_name": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["message_id", "role", "content", "provenance", "immutable_ref", "source_evidence_ref"],
        "properties": {
          "message_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "participant_id": { "type": ["string", "null"] },
          "content": { "type": "string" },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "source_evidence_ref": { "type": "string", "minLength": 1 },
          "lineage_ref": { "type": ["string", "null"] },
          "lineage_state": {
            "type": ["string", "null"],
            "enum": ["resolved", "not_resolved", null]
          },
          "bundle_state": {
            "type": ["string", "null"],
            "enum": ["resolved", "ambiguous", "unbundled", null]
          },
          "bundle_ref": { "type": ["string", "null"] },
          "bundle_eligibility": {
            "type": ["string", "null"],
            "enum": ["eligible", "not_eligible", null]
          },
          "provenance": { "$ref": "#/$defs/provenance_record" },
          "immutable_ref": {
            "type": "object",
            "required": ["archive_id", "message_hash"],
            "properties": {
              "archive_id": { "type": "string", "minLength": 1 },
              "message_hash": { "type": ["string", "null"] },
              "raw_message_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "bundle_state": { "const": "resolved" } },
              "required": ["bundle_state"]
            },
            "then": {
              "required": ["bundle_ref"],
              "properties": { "bundle_ref": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "if": {
              "properties": { "bundle_state": { "const": "ambiguous" } },
              "required": ["bundle_state"]
            },
            "then": {
              "required": ["bundle_ref"],
              "properties": { "bundle_ref": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "if": {
              "properties": { "lineage_state": { "const": "resolved" } },
              "required": ["lineage_state"]
            },
            "then": {
              "required": ["lineage_ref"],
              "properties": { "lineage_ref": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "if": {
              "properties": { "bundle_eligibility": { "const": "eligible" } },
              "required": ["bundle_eligibility"]
            },
            "then": {
              "required": ["bundle_state"],
              "properties": {
                "bundle_state": {
                  "type": "string",
                  "enum": ["resolved", "ambiguous", "unbundled"]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "provenance_record": {
      "type": "object",
      "required": ["source_type", "source_id", "source_offset", "normalization_adapter", "normalization_version"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_path": { "type": ["string", "null"] },
        "source_uri": { "type": ["string", "null"] },
        "source_id": { "type": "string", "minLength": 1 },
        "source_offset": { "type": ["integer", "null"], "minimum": 0 },
        "raw_message_id": { "type": ["string", "null"] },
        "normalization_adapter": { "type": "string", "minLength": 1 },
        "normalization_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
