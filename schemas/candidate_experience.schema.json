{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julia-persona.org/schemas/candidate_experience.schema.json",
  "title": "Candidate Experience",
  "type": "object",
  "required": ["schema_version", "candidate_id", "source_segments", "detection_signals", "confidence", "provenance_refs", "created_by"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.2.0" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "source_segments": { "type": "array", "items": { "$ref": "#/$defs/segment_ref" }, "minItems": 1 },
    "detection_signals": { "type": "array", "items": { "$ref": "#/$defs/detection_signal" }, "minItems": 1 },
    "confidence": {
      "type": "object",
      "required": ["review_worthiness", "signal_strength", "provenance_quality"],
      "properties": {
        "review_worthiness": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance_quality": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "provenance_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "created_by": {
      "type": "object",
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "segment_ref": {
      "type": "object",
      "required": ["segment_id", "archive_id", "message_ids", "provenance_refs"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "archive_id": { "type": "string", "minLength": 1 },
        "message_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "provenance_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "detection_signal": {
      "type": "object",
      "required": ["signal_type", "strength", "observed_on"],
      "properties": {
        "signal_type": { "type": "string", "enum": ["conversation_length_change", "topic_transition", "emotional_intensity_change", "response_pattern_shift", "repeated_reference", "time_gap_proximity", "manual_review_marker"] },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_on": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "parameters": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      { "required": ["meaning"] },
      { "required": ["impact"] },
      { "required": ["identity_change"] },
      { "required": ["personality"] },
      { "required": ["causal_claim"] },
      { "required": ["relationship_delta"] },
      { "required": ["behavioral_consequence"] },
      { "required": ["runtime_eligibility"] },
      { "required": ["activation_weight"] },
      { "required": ["governance_status"] }
    ]
  },
  "additionalProperties": false
}
